# ────────────────────────────────────────────────────────────
# 复制为 .env 后填入真实密钥。.env 已加入 .gitignore，不会被提交。
# 变量名必须与 config/config.yaml 里的 api_key_env 一致，否则读不到。
#
# 填完运行一次验证（自动检测 key 是否有效、实名是否通过）：
#   python scripts/verify_keys.py
# ────────────────────────────────────────────────────────────

# 硅基流动 —— 主力，四道工序全免费（必须实名认证）
# 格式：sk- 开头，64 位左右
SILICONFLOW_API_KEY=

# 阿里云百炼 —— 备份，免费档取消时顶上（约 ¥19 全量）
# 格式：sk- 开头
DASHSCOPE_API_KEY=

# 智谱 —— 末位备份，性价比最低（约 ¥192 全量），可不填
# 格式：32 位十六进制 . 大写后缀
ZHIPU_API_KEY=

# 问答用的 LLM（Web UI 的对话功能需要；检索本身不需要）
DEEPSEEK_API_KEY=
